# Пример конфигурации для docker compose. Скопируйте в .env и задайте собственные значения.
# Секреты генерируйте, например: openssl rand -base64 48

POSTGRES_DB=ot
POSTGRES_USER=ot
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

JWT_ACCESS_SECRET=CHANGE_ME_LONG_RANDOM_STRING_1
JWT_REFRESH_SECRET=CHANGE_ME_LONG_RANDOM_STRING_2
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Адрес, по которому пользователи открывают систему
PUBLIC_URL=http://localhost:8080
# true — при работе через HTTPS (обязательно для production)
COOKIE_SECURE=false

# Публикация frontend (nginx). По умолчанию только localhost; для доступа из сети — 0.0.0.0 или используйте профиль https
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# Для профиля https (Caddy, Let's Encrypt): DNS-имя сервера
DOMAIN=ot.example.local

APP_TIMEZONE=Europe/Minsk
UPLOAD_MAX_MB=10
SWAGGER_ENABLED=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

BACKUP_KEEP_DAYS=30
BACKUP_HOUR=02
