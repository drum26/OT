# Скопируйте в .env и задайте собственные значения. Не храните реальные секреты в репозитории.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://ot:CHANGE_ME@localhost:5432/ot?schema=public
# Длинные случайные строки (например: openssl rand -base64 48)
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
# Разрешённый origin фронтенда (через запятую)
CORS_ORIGINS=http://localhost:5173
# true при работе за HTTPS (cookie с флагом Secure)
COOKIE_SECURE=false
UPLOAD_DIR=./storage/uploads
UPLOAD_MAX_MB=10
BACKUP_DIR=./storage/backups
# Часовой пояс предприятия для расчёта сроков «на дату»
APP_TIMEZONE=Europe/Minsk
# Отключение фоновых заданий (например, в тестах)
SCHEDULER_ENABLED=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
